
generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model Group {
  id                  String                @id @default(cuid())
  name                String                @unique
  legalName           String
  logo                Json
  taxId               String
  industry            String
  address             String
  city                String
  province            String
  postalCode          String
  country             String
  email               String
  phone               String
  website             String?
  subdomain           String                @unique
  subscriptionId      String?
  billingCycle        BillingCycle?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @default(now()) @updatedAt
  entities            Entity[]
  users               User[]
  accountCategories   AccountCategory[]
  roles               Role[]
  subscription        Subscription?
  subscriptionHistory SubscriptionHistory[]
  auditLogs           AuditLog[]
}

